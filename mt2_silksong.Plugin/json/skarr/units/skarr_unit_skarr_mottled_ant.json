        {
          "english": "<i>Our mark is no curse...</i>"
        }
      ]
    },
    {
      "id": "Curvesickle",
      "names": {
        "english": "Curvesickle"
      },
      "descriptions": {
        "english": "Deal damage equal to this unit's power to the front enemy unit."
      },
      "is_an_ability": true,
      "cooldown": 1,
      "initial_cooldown": 0,
      "targetless": true,
      "targets_room": false,
      "card_type": "spell",
      "effects": [ "@SkarrMottledAntCurvesickleEffect" ]
