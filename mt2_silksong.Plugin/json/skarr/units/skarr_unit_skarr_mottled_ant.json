      "target_mode": "front_in_room",
      "target_team": "heroes"
    },
    {
      "id": "SkarrMottledAntScaleHpEffect",
      "name": "@CardEffectBuffMaxHealth",
      "target_mode": "self",
      "target_team": "monsters",
      "param_int": 1
