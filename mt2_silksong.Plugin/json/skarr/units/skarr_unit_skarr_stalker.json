  "game_objects": [
    {
      "id": "SkarrStalkerCardArt",
      "type": "card_art",
      "extensions": {
        "card_art": {
          "sprite": "@SkarrStalkerCardSprite"
        }
      }
    },
    {
      "id": "SkarrStalkerCharacterArt",
      "type": "character_art",
      "extensions": {
        "character_art": {
          "sprite": "@SkarrStalkerCharacterSprite"
        }
      }
    }
  ],
  "sprites": [
    {
      "id": "SkarrStalkerCardSprite",
      "path": "textures/skarr/SkarrStalkerSprite.png"
    },
    {
      "id": "SkarrStalkerCharacterSprite",
      "path": "textures/skarr/SkarrStalkerSprite.png"
    }
  ]
