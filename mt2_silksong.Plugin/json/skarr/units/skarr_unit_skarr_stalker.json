    "ability": "@SkarrStalkerDiveAbility",
    "starting_status_effects": [
      {
        "status": "multistrike",
        "count": 1
      }
    ]
  }
  ],
  "effects": [
    {
      "id": "SpawnSkarrStalkerDraftUnit",
      "name": "@CardEffectSpawnMonster",
      "target_mode": "room",
