    {
      "id": "SkarrStalkerMultistrikeEffect",
      "name": "CardEffectAddStatusEffect",
      "target_mode": "self",
      "param_status_effects": [
        {
          "status": "multistrike",
          "count": 1
        }
      ]
    }
