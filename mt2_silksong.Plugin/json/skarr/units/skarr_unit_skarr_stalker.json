      "card_type": "monster",
      "rarity": "common",
      "class": "@ClassSkarr",
      "targets_room": true,
      "targetless": false,
      "pools": [ "@UnitsSkarrClanBanner", "UnitsAllBanner" ],
      "effects": [ "@SpawnSkarrStalkerDraftUnit" ],
      "lore_tooltips": [
        {
          "english": "Skilled ant hunter bearing blade and armour fashioned from bone."
        }
      ]
    },
    {
      "id": "SkarrStalkerDiveAbility",
      "names": {
        "english": "Stalker's Dive"
      },
      "descriptions": {
        "english": "Advance to the front of the floor and gain [multistrike]."
      },
      "is_an_ability": true,
      "cooldown": 3,
      "initial_cooldown": 1,
      "targetless": true,
      "targets_room": false,
      "card_type": "spell",
      "effects": [ "@SkarrStalkerAdvanceEffect", "@SkarrStalkerMultistrikeEffect" ]
    }
  ],
  "characters": [
  {
    "id": "SkarrStalkerCharacter",
    "names": {
      "english": "Skarr Stalker"
    },
    "character_art": "@SkarrStalkerCharacterArt",
    "size": 2,
    "health": 15,
    "attack_damage": 15,
    "subtypes": [ "@BasicSubtype", "SubtypesData_BannerUnit" ],
