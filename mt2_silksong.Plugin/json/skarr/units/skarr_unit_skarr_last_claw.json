{
  "$schema": "https://github.com/Monster-Train-2-Modding-Group/Trainworks-Reloaded/releases/latest/download/schema.json",
  "cards": [
    {
      "id": "SkarrLastClaw",
      "names": {
        "english": "Last Claw"
      },
      "card_art": "@SkarrLastClawCardArt",
      "cost": 2,
      "card_type": "monster",
      "rarity": "common",
      "class": "@ClassSkarr",
      "targets_room": true,
      "targetless": false,
      "pools": [ "@UnitsSkarrClanBanner", "UnitsAllBanner" ],
      "effects": [ "@SpawnSkarrLastClawDraftUnit" ],
      "lore_tooltips": [
        {
          "english": "Elite former hunter acting as the final line of defence before their mother."
        }
      ],
      "descriptions": {
        "english": "[@queens_guard]"
      }
    }
  ],
  "characters": [
  {
    "id": "SkarrLastClawCharacter",
    "names": {
      "english": "Last Claw"
    },
    "character_art": "@SkarrLastClawCharacterArt",
    "size": 2,
    "health": 30,
    "attack_damage": 35,
    "subtypes": [ "@BasicSubtype", "SubtypesData_BannerUnit" ],
    "triggers": [ "@SkarrSpawnBugsnaxOnDeathTrigger" ],
    "starting_status_effects": [
      {
        "status": "@queens_guard",
        "count": 1
      } 
    ]
  }
  ],
  "effects": [
    {
      "id": "SpawnSkarrLastClawDraftUnit",
      "name": "@CardEffectSpawnMonster",
      "target_mode": "room",
      "param_character": "@SkarrLastClawCharacter"
    }
  ],
  "game_objects": [
    {
      "id": "SkarrLastClawCardArt",
      "type": "card_art",
      "extensions": {
        "card_art": {
          "sprite": "@SkarrLastClawCardSprite"
        }
      }
    },
    {
      "id": "SkarrLastClawCharacterArt",
      "type": "character_art",
      "extensions": {
        "character_art": {
          "sprite": "@SkarrLastClawCharacterSprite"
        }
      }
    }
  ],
  "sprites": [
    {
      "id": "SkarrLastClawCardSprite",
      "path": "textures/skarr/LastClawSprite.png"
    },
    {
      "id": "SkarrLastClawCharacterSprite",
      "path": "textures/skarr/LastClawSprite.png"
    },
    {
      "id": "QueensGuardIcon",
      "path": "textures/icons/BasicRoomIcon.png"
    }
    ],
    "atlas_icons": [
    {
      "id": "QueensGuardIcon",
      "path": "textures/icons/EmptyRoomIcon.png"
    }
  ],
  "status_effects": [
    {
      "id": "queens_guard",
      "class_name": "@StatusEffectQueensGuardState",
      "names": {
        "english": "Queen's Guard"
      },
      "card_tooltips": {
        "english": "Deal's double damage to enemies with daze."
      },
      "character_tooltips": {
        "english": "Deal's double damage to enemies with daze."
      },
      "replacement_texts": {
        "english": "<b>Queen's Guard</b>"
      },
      "is_propagatable": false,
      "is_stackable": false,
      "remove_when_triggered": false,
      "trigger_stage": "on_pre_attacking",
      "icon": "@QueensGuardIcon"
    }
  ]
}