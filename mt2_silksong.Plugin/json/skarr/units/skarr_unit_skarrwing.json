          "english": "Darting predator that clings fast to roofs and outcrops, often summoned to aid its larger companions."
        }
      ]
    }
  ],
  "characters": [
  {
    "id": "SkarrwingCharacter",
    "names": {
      "english": "Skarrwing"
    },
    "character_art": "@SkarrwingCharacterArt",
