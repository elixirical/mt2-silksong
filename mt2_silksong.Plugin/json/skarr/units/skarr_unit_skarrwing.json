          "sprite": "@SkarrwingCharacterSprite"
        }
      }
    }
  ],
  "sprites": [
    {
      "id": "SkarrwingCardSprite",
      "path": "textures/skarr/SkarrwingSprite.png"
    },
    {
      "id": "SkarrwingCharacterSprite",
      "path": "textures/skarr/SkarrwingSprite.png"
    }
  ]
